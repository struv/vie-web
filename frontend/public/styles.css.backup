/* Vie Web - Black Void Aesthetic */
/* Vercel-inspired minimal design with precision polish */
/* Design System: Pure black void, purple/gold accents, WCAG AA compliant */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  /* Color System - Black Void with WCAG AA Compliance */
  --bg-void: #000000;           /* Pure black void */
  --bg-surface: #0a0a0a;        /* Subtle surface */
  --bg-elevated: #111111;       /* Elevated elements */
  
  --text-primary: #fafafa;      /* Clean white - 19.6:1 */
  --text-secondary: #a0a0a0;    /* Readable gray - 6.4:1 (was 4.6:1) */
  --text-tertiary: #707070;     /* Subtle gray - 4.5:1 (was 3.3:1) */
  
  --border-subtle: #222222;     /* Visible on black - 1.35:1 (increased from #1a1a1a) */
  --border-visible: #2a2a2a;    /* Clear borders - 1.6:1 (increased from #222) */
  
  /* Neon accents - subtle, intentional, accessible */
  --accent-purple: #b794f6;     /* Primary accent */
  --accent-purple-dim: #8b6bc4; /* Dimmed purple for subtle states */
  --accent-gold: #d4af37;       /* Warm gold */
  --accent-cyan: #67e8f9;       /* Neon cyan */
  --accent-pink: #ff66aa;       /* Neon pink */
  
  --accent-success: #10b981;    /* Success green */
  --accent-error: #ef4444;      /* Error red */
  
  /* Typography Scale - Clear Hierarchy */
  --font-main: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'SF Pro', sans-serif;
  --font-mono: 'SF Mono', 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
  
  --text-xs: 0.75rem;       /* 12px */
  --text-sm: 0.875rem;      /* 14px */
  --text-base: 1rem;        /* 16px */
  --text-lg: 1.125rem;      /* 18px */
  --text-xl: 1.25rem;       /* 20px */
  --text-2xl: 1.5rem;       /* 24px */
  
  /* Spacing Scale - Consistent Rhythm (4px base) */
  --space-1: 0.25rem;   /* 4px */
  --space-2: 0.5rem;    /* 8px */
  --space-3: 0.75rem;   /* 12px */
  --space-4: 1rem;      /* 16px */
  --space-5: 1.25rem;   /* 20px */
  --space-6: 1.5rem;    /* 24px */
  --space-8: 2rem;      /* 32px */
  --space-12: 3rem;     /* 48px */
  
  /* Easing Functions - Organic, Natural Motion */
  --ease-smooth: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-in-out: cubic-bezier(0.4, 0.0, 0.2, 1);
  --ease-out: cubic-bezier(0.0, 0.0, 0.2, 1);
  --ease-in: cubic-bezier(0.4, 0.0, 1, 1);
  
  /* Shadows - Subtle Depth */
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.5);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.6);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.7);
  
  /* Glow Effects */
  --glow-purple: 0 0 20px rgba(183, 148, 246, 0.3);
  --glow-purple-strong: 0 0 30px rgba(183, 148, 246, 0.5);
  --glow-gold: 0 0 20px rgba(212, 175, 55, 0.3);
  --glow-error: 0 0 20px rgba(239, 68, 68, 0.4);
}

body {
  font-family: var(--font-main);
  background: var(--bg-void);
  color: var(--text-primary);
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.6;
  letter-spacing: -0.01em;
}

#root {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== AVATAR CONTAINER ===== */

.avatar-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 1rem;
  background: var(--bg-void);
  position: relative;
  overflow: hidden;
  min-height: 300px;
  border-bottom: 1px solid var(--border-subtle);
}

.avatar-wrapper {
  position: relative;
  width: 100%;
  max-width: 400px;
  aspect-ratio: 1;
}

.avatar-canvas {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 1;
}

.avatar-ascii {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* OPTIMIZED: Removed expensive drop-shadow filter */
.avatar-symbol {
  font-size: clamp(3rem, 8vw, 6rem);
  font-weight: 300;
  color: var(--breath-color, var(--accent-purple));
  animation: symbolPulse 4s ease-in-out infinite;
  transform: scale(var(--breath-scale, 1));
  transition: transform 0.3s var(--ease-out-smooth);
  will-change: transform;
}

.avatar-core {
  position: absolute;
  width: 120px;
  height: 120px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.core-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 1px solid var(--breath-color, var(--accent-purple));
  border-radius: 50%;
  opacity: 0;
  animation: ringExpand 3s ease-out infinite;
  will-change: transform, opacity;
}

.core-ring:nth-child(1) { animation-delay: 0s; }
.core-ring:nth-child(2) { animation-delay: 1s; }
.core-ring:nth-child(3) { animation-delay: 2s; }

/* OPTIMIZED: Simplified keyframes */
@keyframes symbolPulse {
  0%, 100% {
    text-shadow: 0 0 10px currentColor, 0 0 20px currentColor;
  }
  50% {
    text-shadow: 0 0 20px currentColor, 0 0 40px currentColor;
  }
}

@keyframes ringExpand {
  0% {
    width: 40px;
    height: 40px;
    opacity: 0.6;
  }
  100% {
    width: 160px;
    height: 160px;
    opacity: 0;
  }
}

.status-line {
  position: absolute;
  top: 1rem;
  right: 1.5rem;
  font-size: 0.8rem;
  color: var(--text-tertiary);
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
  text-transform: lowercase;
  z-index: 10;
}

/* ===== CHAT AREA ===== */

.chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 1.5rem 1rem 1rem;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.message {
  display: flex;
  flex-direction: column;
  max-width: 80%;
  padding: 1rem 1.25rem;
  border-radius: 6px;
  animation: fadeIn 0.3s var(--ease-out-smooth);
  line-height: 1.6;
}

@keyframes fadeIn {
  from { 
    opacity: 0; 
    transform: translateY(8px);
  }
  to { 
    opacity: 1; 
    transform: translateY(0);
  }
}

.message.user {
  align-self: flex-end;
  background: var(--bg-elevated);
  border: 1px solid var(--border-visible);
  color: var(--text-primary);
}

.message.assistant {
  align-self: flex-start;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
}

.message-content {
  font-size: 0.95rem;
  line-height: 1.6;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.message-time {
  font-size: 0.7rem;
  color: var(--text-tertiary);
  margin-top: 0.5rem;
  font-family: var(--font-mono);
}

/* ===== INPUT AREA ===== */

.input-container {
  padding: 1rem 1.5rem;
  background: var(--bg-void);
  border-top: 1px solid var(--border-subtle);
  display: flex;
  gap: 0.75rem;
}

.input-wrapper {
  flex: 1;
  position: relative;
}

.message-input {
  width: 100%;
  padding: 0.875rem 1rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-visible);
  border-radius: 6px;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 0.95rem;
  resize: none;
  outline: none;
  transition: border-color 0.2s var(--ease-out-smooth), background 0.2s var(--ease-out-smooth);
  line-height: 1.5;
}

.message-input::placeholder {
  color: var(--text-tertiary);
}

.message-input:focus {
  border-color: var(--accent-purple);
  background: var(--bg-elevated);
}

.send-button {
  padding: 0.875rem 1.5rem;
  background: var(--bg-elevated);
  color: var(--text-primary);
  border: 1px solid var(--border-visible);
  border-radius: 6px;
  font-weight: 500;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.2s var(--ease-out-smooth);
  white-space: nowrap;
}

.send-button:hover {
  background: var(--bg-surface);
  border-color: var(--accent-purple);
  transform: translateY(-1px);
}

.send-button:active {
  transform: translateY(0);
}

.send-button:disabled {
  opacity: 0.3;
  cursor: not-allowed;
  transform: none;
}

/* ===== SCROLLBAR ===== */

.messages::-webkit-scrollbar {
  width: 6px;
}

.messages::-webkit-scrollbar-track {
  background: transparent;
}

.messages::-webkit-scrollbar-thumb {
  background: var(--border-visible);
  border-radius: 3px;
}

.messages::-webkit-scrollbar-thumb:hover {
  background: var(--text-tertiary);
}

/* ===== TYPING INDICATOR ===== */

.typing-indicator {
  display: flex;
  gap: 4px;
  padding: 0.5rem;
}

.typing-indicator span {
  width: 6px;
  height: 6px;
  background: var(--text-tertiary);
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { 
    transform: translateY(0); 
    opacity: 0.4;
  }
  30% { 
    transform: translateY(-8px); 
    opacity: 1;
  }
}

/* ===== VOICE CONTROLS ===== */

.voice-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  background: var(--bg-void);
  border-top: 1px solid var(--border-subtle);
  gap: 1.5rem;
}

.voice-controls.unsupported {
  justify-content: center;
}

.voice-unsupported-message {
  color: var(--text-tertiary);
  font-size: 0.85rem;
  font-style: italic;
}

.voice-input-section {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

.voice-output-section {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.voice-mic-btn {
  position: relative;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--bg-surface);
  border: 1px solid var(--border-visible);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s var(--ease-out-smooth);
  flex-shrink: 0;
}

.voice-mic-btn:hover {
  border-color: var(--text-secondary);
  transform: scale(1.05);
}

.voice-mic-btn:active {
  transform: scale(0.95);
}

.mic-icon {
  font-size: 1.5rem;
  z-index: 2;
}

.pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid var(--accent-purple);
  border-radius: 50%;
  opacity: 0;
  top: 0;
  left: 0;
  will-change: transform, opacity;
}

.voice-mic-btn.listening {
  border-color: var(--accent-purple);
  background: rgba(183, 148, 246, 0.05);
}

.voice-mic-btn.listening .pulse-ring {
  animation: voicePulse 1.5s ease-out infinite;
}

.voice-mic-btn.listening .pulse-ring:nth-child(3) {
  animation-delay: 0.75s;
}

.voice-mic-btn.processing {
  border-color: var(--accent-cyan);
  background: rgba(103, 232, 249, 0.05);
}

.voice-mic-btn.processing .mic-icon {
  animation: processingRotate 1s linear infinite;
}

.voice-mic-btn.error {
  border-color: #ff6b6b;
  background: rgba(255, 107, 107, 0.05);
}

@keyframes voicePulse {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

@keyframes processingRotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.voice-status {
  font-size: 0.8rem;
  color: var(--text-tertiary);
  min-height: 1.2rem;
  font-family: var(--font-mono);
}

.voice-status.listening { color: var(--accent-purple); }
.voice-status.processing { color: var(--accent-cyan); }
.voice-status.error { color: #ff6b6b; }

.voice-transcript {
  display: none;
  padding: 0.625rem 1rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-visible);
  border-radius: 6px;
  font-size: 0.9rem;
  color: var(--text-primary);
  max-width: 400px;
  animation: fadeIn 0.2s ease;
}

.voice-transcript.interim {
  opacity: 0.5;
  font-style: italic;
}

.voice-transcript.final {
  opacity: 1;
  border-color: var(--accent-purple);
}

.voice-tts-toggle {
  padding: 0.625rem 1rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-visible);
  border-radius: 6px;
  color: var(--text-secondary);
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s var(--ease-out-smooth);
  white-space: nowrap;
  font-weight: 500;
}

.voice-tts-toggle:hover {
  border-color: var(--text-secondary);
  color: var(--text-primary);
}

.voice-tts-toggle.active {
  background: var(--bg-elevated);
  border-color: var(--accent-purple);
  color: var(--accent-purple);
}

.voice-speaker-indicator {
  display: none;
  gap: 3px;
  align-items: center;
}

.speaker-pulse {
  width: 2px;
  height: 14px;
  background: var(--accent-purple);
  border-radius: 2px;
  animation: speakerPulse 0.8s ease-in-out infinite;
}

.speaker-pulse:nth-child(2) { animation-delay: 0.15s; }
.speaker-pulse:nth-child(3) { animation-delay: 0.3s; }

@keyframes speakerPulse {
  0%, 100% {
    height: 14px;
    opacity: 0.5;
  }
  50% {
    height: 20px;
    opacity: 1;
  }
}

.voice-selection-panel {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 0.75rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-visible);
  border-radius: 6px;
  min-width: 200px;
}

.voice-label {
  font-size: 0.7rem;
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
}

.voice-select {
  padding: 0.5rem;
  background: var(--bg-elevated);
  border: 1px solid var(--border-visible);
  border-radius: 4px;
  color: var(--text-primary);
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s var(--ease-out-smooth);
  font-family: var(--font-main);
}

.voice-select:hover {
  border-color: var(--text-secondary);
}

.voice-select:focus {
  outline: none;
  border-color: var(--accent-purple);
}

.voice-select option {
  background: var(--bg-elevated);
  color: var(--text-primary);
}

.voice-select option:disabled {
  color: var(--text-tertiary);
  font-style: italic;
}

#elevenlabs-voice-panel {
  margin-top: 0.25rem;
}

.voice-speaker-status {
  display: none;
  font-size: 0.7rem;
  color: var(--accent-purple);
  font-style: italic;
  margin-left: 0.5rem;
}

/* ===== MOBILE RESPONSIVE ===== */

@media (max-width: 768px) {
  .avatar-container {
    padding: 1.5rem 1rem;
    min-height: 240px;
  }
  
  .avatar-wrapper {
    max-width: 280px;
  }
  
  .avatar-symbol {
    font-size: clamp(2.5rem, 12vw, 4rem);
  }
  
  .status-line {
    top: 0.75rem;
    right: 1rem;
    font-size: 0.7rem;
  }
  
  .chat-container {
    padding: 1rem 0.5rem 0.75rem;
  }
  
  .messages {
    padding: 0 0.75rem;
    gap: 1rem;
  }
  
  .message {
    max-width: 90%;
    padding: 0.875rem 1rem;
  }
  
  .message-content {
    font-size: 1rem;
  }
  
  .input-container {
    padding: 1rem;
    gap: 0.625rem;
  }
  
  .message-input {
    padding: 1rem;
    font-size: 1rem;
    min-height: 52px;
  }
  
  .send-button {
    padding: 1rem 1.25rem;
    min-width: 70px;
    min-height: 52px;
  }
  
  .voice-controls {
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }
  
  .voice-input-section,
  .voice-output-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  
  .voice-output-section {
    justify-content: center;
    gap: 1rem;
  }
  
  .voice-mic-btn {
    width: 60px;
    height: 60px;
  }
  
  .mic-icon {
    font-size: 1.75rem;
  }
  
  .voice-tts-toggle {
    padding: 0.75rem 1.25rem;
    min-height: 44px;
  }
  
  .voice-transcript {
    max-width: 100%;
    padding: 0.75rem 1rem;
  }
  
  .voice-status {
    font-size: 0.85rem;
    text-align: center;
    width: 100%;
  }
  
  .voice-selection-panel {
    width: 100%;
    min-width: 0;
  }
}

::selection {
  background: rgba(183, 148, 246, 0.2);
  color: var(--text-primary);
}

::-moz-selection {
  background: rgba(183, 148, 246, 0.2);
  color: var(--text-primary);
}
